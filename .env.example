# ─────────────────────────────────────────────────────────────────────────────
# Hookline — viral video analysis & original script generation
# Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5000
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173
# Password wall for the web app (required in production; leave empty for local development)
APP_PASSWORD=
# Optional: lets scripts call the API with "Authorization: Bearer <token>"
API_AUTH_TOKEN=

# ── Infrastructure ───────────────────────────────────────────────────────────
# PostgreSQL — Neon (https://console.neon.tech) is the default. In your project's dashboard click
# "Connect": copy the POOLED string into DATABASE_URL and the direct one (pooling off) into DATABASE_URL_UNPOOLED.
# Neon databases are UTF8 by default, which Hindi transcripts need.
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Used only for migrations (DDL over the direct connection, as Neon recommends). Optional.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Empty = automatic (on for *.neon.tech and sslmode=require; certificates are verified). true/false to force.
DB_SSL=
# Local PostgreSQL instead: docker compose --profile local-db up -d, then
# DATABASE_URL=postgres://reelscript:reelscript@localhost:5432/reelscript  (and leave DATABASE_URL_UNPOOLED empty)

# Redis for the job queue (docker compose up -d starts it, or use a hosted Redis such as Upstash: rediss://...)
REDIS_URL=redis://localhost:6379
# bullmq (production, durable) | memory (single process, tests/dev only — not durable)
QUEUE_DRIVER=bullmq
# true = run workers inside the API process (simple single-machine setup)
RUN_WORKERS_IN_API=false

# ── AI & media providers ─────────────────────────────────────────────────────
# AssemblyAI — https://www.assemblyai.com/dashboard
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_SPEECH_MODELS=universal-3-5-pro,universal-2
# Hint for language detection (not a strict filter)
ASSEMBLYAI_EXPECTED_LANGUAGES=hi,en

# Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Videos longer than this are analysed in chunks
GEMINI_MAX_SINGLE_PASS_SECONDS=2700
GEMINI_CHUNK_SECONDS=1200

# Embeddings for MatchingService: gemini | local (offline multilingual-e5-small) | hash (lexical fallback)
# Empty = gemini when a Gemini key is set, otherwise hash.
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# floor,ceil from `npm run calibrate -w server` (empty = provider default)
EMBEDDING_CALIBRATION=

# Provider switches (mock = offline test doubles)
DOWNLOADER=yt-dlp
TRANSCRIBER=assemblyai
ANALYZER=gemini
# Optional: cookies.txt for videos YOU are authorised to access (never used to bypass access controls)
YTDLP_COOKIES_FILE=
YTDLP_PATH=
ALLOWED_VIDEO_HOSTS=facebook.com,www.facebook.com,m.facebook.com,web.facebook.com,fb.watch

# ── Claude Skill (script generation only) ────────────────────────────────────
# agent-sdk  — run the skill folder through the Claude Agent SDK (needs ANTHROPIC_API_KEY or Bedrock/Vertex/Foundry env)
# manual     — export a job file per video; run the skill in Claude Code and import the script in the dashboard
# disabled   — produce Story DNA only
# Empty = automatic: agent-sdk when ANTHROPIC_API_KEY is set, otherwise manual (if a skill folder is found), otherwise disabled.
SKILL_MODE=
# Folder containing the skill's SKILL.md (absolute, or relative to the repo root).
# Empty = ../scriptwriter-skill-1.0.0 next to this repository, when present.
SKILL_DIR=
# Optional: override the skill name from SKILL.md
SKILL_NAME=
SKILL_MODEL=
SKILL_MAX_TURNS=8
ANTHROPIC_API_KEY=

# ── Scoring (starting values — tune after reviewing real matches; editable in the dashboard) ──
MATCH_THRESHOLD=75
STORY_WEIGHT=40
CHARACTER_WEIGHT=30
DIALOGUE_WEIGHT=30
MIN_MATCH_CONFIDENCE=0.70

# ── Limits & concurrency ─────────────────────────────────────────────────────
MAX_CONCURRENT_JOBS=5
# Per-stage overrides (default to MAX_CONCURRENT_JOBS)
CONCURRENCY_DOWNLOAD=
CONCURRENCY_FFMPEG=
CONCURRENCY_TRANSCRIBE=
CONCURRENCY_ANALYZE=
CONCURRENCY_EMBED=
CONCURRENCY_GENERATE=2
MAX_VIDEO_DURATION_SECONDS=900
MAX_VIDEO_SIZE_MB=500
MAX_UPLOAD_MB=10
MAX_ROWS_PER_BATCH=5000

# Stage timeouts (seconds)
DOWNLOAD_TIMEOUT_SECONDS=300
FFMPEG_TIMEOUT_SECONDS=180
TRANSCRIBE_TIMEOUT_SECONDS=900
ANALYZE_TIMEOUT_SECONDS=900
GENERATE_TIMEOUT_SECONDS=600

# ── Storage ──────────────────────────────────────────────────────────────────
TEMP_VIDEO_DIR=server/storage/videos
TEMP_AUDIO_DIR=server/storage/audio
SKILL_EXCHANGE_DIR=server/storage/skill-exchange
# 0 = delete media right after matching
MEDIA_RETENTION_HOURS=24

LOG_LEVEL=info

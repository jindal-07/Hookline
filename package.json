{
  "name": "reelscript-platform",
  "private": true,
  "version": "2.0.0",
  "description": "Viral video analysis and original script generation platform",
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w server & npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "dev:worker": "npm run worker -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "worker": "npm run worker -w server",
    "db:migrate": "npm run db:migrate -w server",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "demo": "npm run build -w client && npm run demo -w server"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "youtube-dl-exec@3.1.17": true,
    "protobufjs@7.6.6": true,
    "@google/genai@2.28.0": true,
    "msgpackr-extract": false,
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true,
    "onnxruntime-node@1.30.0": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "supertest": "^7.3.1",
    "vitest": "^5.0.4"
  }
}
